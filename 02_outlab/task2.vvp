    %fork TD_tb.check, S_0x59e8444d9130;
    %join;
    %delay 9, 0;
    %load/vec4 v0x59e844503ee0_0;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_3.0, 4;
