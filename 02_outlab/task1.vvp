#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 9;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x58a1f10a7990 .scope module, "tb" "tb" 2 3;
 .timescale -9 -9;
v0x58a1f10bdb80_0 .var "a", 0 0;
v0x58a1f10bdc40_0 .var "b", 0 0;
v0x58a1f10bdd10_0 .var "sel", 0 0;
v0x58a1f10bde10_0 .net "y", 0 0, L_0x58a1f10be1d0;  1 drivers
S_0x58a1f10a7b20 .scope module, "uut" "mux_dataflow" 2 7, 3 1 0, S_0x58a1f10a7990;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /INPUT 1 "sel";
    .port_info 3 /OUTPUT 1 "y";
L_0x58a1f10be000 .functor AND 1, L_0x58a1f10bdee0, v0x58a1f10bdb80_0, C4<1>, C4<1>;
L_0x58a1f10be110 .functor AND 1, v0x58a1f10bdd10_0, v0x58a1f10bdc40_0, C4<1>, C4<1>;
L_0x58a1f10be1d0 .functor OR 1, L_0x58a1f10be000, L_0x58a1f10be110, C4<0>, C4<0>;
v0x58a1f1098360_0 .net *"_ivl_1", 0 0, L_0x58a1f10bdee0;  1 drivers
v0x58a1f10bd5e0_0 .net *"_ivl_2", 0 0, L_0x58a1f10be000;  1 drivers
v0x58a1f10bd6c0_0 .net *"_ivl_4", 0 0, L_0x58a1f10be110;  1 drivers
v0x58a1f10bd7b0_0 .net "a", 0 0, v0x58a1f10bdb80_0;  1 drivers
v0x58a1f10bd870_0 .net "b", 0 0, v0x58a1f10bdc40_0;  1 drivers
v0x58a1f10bd980_0 .net "sel", 0 0, v0x58a1f10bdd10_0;  1 drivers
v0x58a1f10bda40_0 .net "y", 0 0, L_0x58a1f10be1d0;  alias, 1 drivers
L_0x58a1f10bdee0 .reduce/nor v0x58a1f10bdd10_0;
    .scope S_0x58a1f10a7990;
T_0 ;
    %vpi_call 2 15 "$monitor", "At time %0t: a = %b, b = %b, sel = %b -> y = %b", $time, v0x58a1f10bdb80_0, v0x58a1f10bdc40_0, v0x58a1f10bdd10_0, v0x58a1f10bde10_0 {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x58a1f10a7990;
T_1 ;
    %vpi_call 2 20 "$dumpfile", "task1.vcd" {0 0 0};
    %vpi_call 2 21 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x58a1f10a7990 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x58a1f10bdb80_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x58a1f10bdc40_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x58a1f10bdd10_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x58a1f10bdb80_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x58a1f10bdc40_0, 0, 1;
