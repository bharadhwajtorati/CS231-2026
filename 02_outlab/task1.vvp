    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x58a1f10bdc40_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x58a1f10bdd10_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x58a1f10bdb80_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x58a1f10bdc40_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x58a1f10bdd10_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x58a1f10bdb80_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x58a1f10bdc40_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x58a1f10bdd10_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x58a1f10bdb80_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x58a1f10bdc40_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x58a1f10bdd10_0, 0, 1;
    %delay 10, 0;
    %vpi_call 2 30 "$finish" {0 0 0};
