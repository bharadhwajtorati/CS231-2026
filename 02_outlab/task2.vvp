    .port_info 2 /INPUT 1 "sel";
    .port_info 3 /OUTPUT 1 "y";
L_0x59e8445042a0 .functor AND 1, L_0x59e844504200, v0x59e844503cc0_0, C4<1>, C4<1>;
L_0x59e844504360 .functor AND 1, v0x59e844503f80_0, v0x59e844503dd0_0, C4<1>, C4<1>;
