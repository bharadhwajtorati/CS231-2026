    %and;
    %or;
    %assign/vec4 v0x59e8445033c0_0, 0;
    %jmp T_1;
    .thread T_1, $push;
    .scope S_0x59e8444d8fa0;
T_2 ;
    %vpi_call 2 23 "$monitor", "At time %0t: a = %b, b = %b, sel = %b -> dataflow = %b, behavioral = %b", $time, v0x59e844503cc0_0, v0x59e844503dd0_0, v0x59e844503f80_0, v0x59e844504160_0, v0x59e844504070_0 {0 0 0};
    %end;
    .thread T_2;
