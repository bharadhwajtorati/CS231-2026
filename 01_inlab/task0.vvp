#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 9;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x62dbde4f6530 .scope module, "tb" "tb" 2 3;
 .timescale -9 -9;
v0x62dbde509230_0 .var "a", 0 0;
v0x62dbde509300_0 .var "b", 0 0;
v0x62dbde5093d0_0 .net "y", 0 0, L_0x62dbde5094d0;  1 drivers
S_0x62dbde4f66c0 .scope module, "uut" "and_gate" 2 7, 3 1 0, S_0x62dbde4f6530;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "in1";
    .port_info 1 /INPUT 1 "in2";
    .port_info 2 /OUTPUT 1 "out";
L_0x62dbde5094d0 .functor AND 1, v0x62dbde509230_0, v0x62dbde509300_0, C4<1>, C4<1>;
v0x62dbde4e5810_0 .net "in1", 0 0, v0x62dbde509230_0;  1 drivers
v0x62dbde509050_0 .net "in2", 0 0, v0x62dbde509300_0;  1 drivers
v0x62dbde509110_0 .net "out", 0 0, L_0x62dbde5094d0;  alias, 1 drivers
    .scope S_0x62dbde4f6530;
T_0 ;
    %vpi_call 2 14 "$monitor", "At time %0t: a = %b, b = %b, y = %b", $time, v0x62dbde509230_0, v0x62dbde509300_0, v0x62dbde5093d0_0 {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x62dbde4f6530;
T_1 ;
    %vpi_call 2 18 "$dumpfile", "task0.vcd" {0 0 0};
    %vpi_call 2 19 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x62dbde4f6530 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x62dbde509230_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x62dbde509300_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x62dbde509230_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x62dbde509300_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x62dbde509230_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x62dbde509300_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x62dbde509230_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x62dbde509300_0, 0, 1;
    %delay 10, 0;
    %vpi_call 2 26 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "task0/tb_task0.v";
    "task0/and_gate.v";
